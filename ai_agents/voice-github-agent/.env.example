# Get this from https://www.assemblyai.com/dashboard/signup
# Used for both the Sync API (transcription) and the LLM Gateway (agent).
ASSEMBLYAI_API_KEY=

# A GitHub personal access token. Needs at least:
#   - classic token: "repo" scope
#   - fine-grained token: Contents (read) + Issues (read & write) on the repo below
GITHUB_TOKEN=

# The single repo this v1 operates on, as "owner/name", e.g. "octocat/hello-world"
GITHUB_REPO=
