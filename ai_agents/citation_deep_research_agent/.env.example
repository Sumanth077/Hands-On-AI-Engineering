# LlamaCloud API key -- the only cloud dependency. Used by LlamaParse to parse PDFs.
# Get it at https://cloud.llamaindex.ai (Settings -> API Keys). Free $250 credits on signup.
LLAMA_CLOUD_API_KEY=llx-your-key-here

# Ollama (local). Defaults assume Ollama is running on this machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Retrieval / citation tuning (optional; sensible defaults).
# Fewer chunks -> shorter prompts -> fewer refine passes -> faster on small models.
SIMILARITY_TOP_K=4
CITATION_CHUNK_SIZE=512
# The citation engine runs several sequential generations per question, and the
# first call also loads the model into memory. Keep this high to avoid timeouts.
OLLAMA_REQUEST_TIMEOUT=600

# Context window. Keep modest so Ollama does not try to allocate a huge KV cache
# (some models default to 100k+ context). 8192 is plenty; drop to 4096 on low RAM.
OLLAMA_NUM_CTX=8192

# Where parsed docs and the vector index are cached (so a PDF is parsed once).
CACHE_DIR=.cache
