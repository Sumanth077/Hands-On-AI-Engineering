# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Run `uv run python scripts/list_nebius_models.py` and confirm this ID is available.
NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily web search
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research-agent-with-review

# JEV decision model used by the review layer
AI_GATEWAY_API_KEY=
JEV_BASE_URL=https://ai-gateway.vercel.sh/v1
JEV_MODEL=typesafe-ai/jev

