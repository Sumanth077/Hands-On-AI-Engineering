APIFY_TOKEN=replace_with_local_token
APIFY_ACCOUNT_PLAN=unknown

# Live execution is disabled by default; enable only for authorized API work.
REPOSCOUT_ENABLE_LIVE=false
REPOSCOUT_LLM_PROVIDER=openai
# Active provider: official OpenAI SDK / Responses API. Persistent pre-request cost guard.
# Unknown models fail closed; no automatic provider/model fallback.
OPENAI_API_KEY=replace_with_local_openai_key
OPENAI_MODEL=gpt-6-luna


REPOSCOUT_MAX_WEB_REQUESTS=30
REPOSCOUT_MAX_MODEL_CALLS=30
REPOSCOUT_MAX_ITERATIONS=3
REPOSCOUT_CONCURRENCY=3
REPOSCOUT_MAX_INPUT_CHARS=80000
REPOSCOUT_MAX_OUTPUT_CHARS=24000
REPOSCOUT_MAX_OUTPUT_TOKENS=4000
REPOSCOUT_MAX_SOURCE_CHARS=12000


# Optional: restore a real local result under this project's outputs/ directory.
# REPOSCOUT_RESTORE_RESULT=outputs/live-YOUR_SESSION/result.json

# Optional Gemini adapter; used only when selected explicitly, never as a fallback.
# GEMINI_API_KEY=replace_with_local_gemini_key
# GEMINI_MODEL=gemini-3.5-flash-lite
