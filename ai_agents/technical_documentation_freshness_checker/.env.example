# LandingAI ADE API key. Create one in the LandingAI platform.
VISION_AGENT_API_KEY=your_landingai_api_key

# Parallel API key. Create one at platform.parallel.ai.
PARALLEL_API_KEY=your_parallel_api_key

# Optional. Use "eu" only with a LandingAI EU-region API key.
LANDINGAI_ENVIRONMENT=us

# Safety limit for the number of distinct stale-prone claims checked automatically.
MAX_CLAIMS=25
