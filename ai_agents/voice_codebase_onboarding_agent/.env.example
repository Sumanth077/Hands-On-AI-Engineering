# Required for repository reasoning with GLM 5.3.
AI_GATEWAY_API_KEY=

# Optional fallback when using another OpenAI-compatible endpoint.
LLM_API_KEY=

# GLM 5.3 is the default model for this project.
LLM_MODEL=zai/glm-5.3
LLM_BASE_URL=https://ai-gateway.vercel.sh/v1

# Required only for spoken questions and Drama 3 narration.
FISH_API_KEY=

# Optional. Leave blank to use Fish Audio's documented public Drama 3 Delia voice.
FISH_REFERENCE_ID=

# Optional. Raises GitHub's public API rate limit when inspecting repositories.
GITHUB_TOKEN=

