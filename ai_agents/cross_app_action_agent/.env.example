# Add this here or enter it in the app. The app keeps an entered key only for
# the active browser session.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_MODEL=zai/glm-5.3

# Liner Actions MCP is a remote Streamable HTTP MCP server.
LINER_ACTIONS_MCP_URL=https://actions.liner.com/api/v1/mcp

# FastMCP opens a browser and listens here for the OAuth callback.
LINER_OAUTH_CALLBACK_PORT=8765

