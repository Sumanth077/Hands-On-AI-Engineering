# Telnyx API key (starts with KEY...). Used for Inference and, optionally, SMS.
# Get it at portal.telnyx.com -> API Keys.
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxx

# Telnyx Inference (OpenAI-compatible endpoint). Defaults are correct for Telnyx.
INFERENCE_BASE_URL=https://api.telnyx.com/v2/ai/openai
INFERENCE_MODEL=zai-org/GLM-5.3-Flash

# Business profile injected into the agent at call start (Dynamic Variables webhook).
BUSINESS_NAME=Brightsmile Dental
BUSINESS_HOURS=Mon-Fri, 9:00 AM to 5:00 PM
BUSINESS_TIMEZONE=America/New_York
BUSINESS_SERVICES=Checkup, Cleaning, Whitening, Emergency visit
SUPPORT_EMAIL=front-desk@example.com

# Scheduling
SLOT_LENGTH_MIN=30
BOOKING_HORIZON_DAYS=14

# Optional SMS follow-up. Leave SEND_SMS=false for a safe demo (no messages sent).
# When true, the follow-up drafted by Inference is texted to the caller.
SEND_SMS=false
SMS_FROM=+15551230000

# Storage and server
DB_PATH=.data/appointments.db
HOST=0.0.0.0
PORT=8000
